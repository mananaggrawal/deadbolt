# /opt/mystery-rooms/.env on the server. You don't edit it there: the deploy workflow writes it
# from the repo's GitHub Actions secrets on every deploy (deploy/setup-secrets.sh sets those up).
# No quotes around values.

# --- the site ---
DOMAIN=example.com
SITE_NAME=Mystery Rooms
CONTACT_EMAIL=you@example.com
ADMIN_EMAILS=you@example.com
REQUIRE_LOGIN=false
SITE_TZ=Asia/Kolkata

# --- Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client, type Web) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- secrets (long random strings: openssl rand -hex 32) ---
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
UMAMI_APP_SECRET=

# --- visitor analytics (after the first deploy: stats.<domain> > Settings > Websites > Add) ---
UMAMI_WEBSITE_ID=

# --- the app image (set by the workflow) ---
APP_IMAGE=ghcr.io/your-github-name/mystery-rooms
APP_TAG=latest
STAGING_TAG=staging
APP_VERSION=dev
COMPOSE_PROFILES=staging

# --- nightly database backups to Cloudflare R2 (optional; leave empty to skip) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
BACKUP_PASSPHRASE=
